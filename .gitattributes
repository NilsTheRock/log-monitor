# Normalize line endings in the repository; check out platform-specific where it matters.
* text=auto

# Shell scripts and sample logs must keep LF, also on Windows checkouts.
mvnw text eol=lf
*.sh text eol=lf
*.log text eol=lf

# Windows batch files need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png binary
